terraform {
  backend "s3" {
    # Bucket name is generated by scripts/bootstrap-backend.sh
    # Format: ecs-project-tfstate-<your-aws-account-id>
    bucket         = "ecs-project-tfstate-<ACCOUNT_ID>"
    key            = "ecs/dev/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "terraform-state-lock"
    encrypt        = true
  }
}
