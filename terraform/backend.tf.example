terraform {
  backend "s3" {
    # ⚠️  This is a TEMPLATE file. DO NOT add real values here.
    # ⚠️  Run ./scripts/bootstrap-backend.sh to generate the real backend.tf
    #     That script will replace <ACCOUNT_ID> with your actual AWS Account ID.
    #
    # The generated backend.tf is gitignored — your Account ID will NOT be committed.
    bucket         = "ecs-project-tfstate-<ACCOUNT_ID>"
    key            = "ecs/dev/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "terraform-state-lock"
    encrypt        = true
  }
}
