terraform {
  backend "s3" {
    # Template file. Run ./scripts/bootstrap-backend.sh to generate backend.tf.
    # The generated backend.tf is gitignored to avoid committing account IDs.
    bucket       = "ecs-project-tfstate-<ACCOUNT_ID>"
    key          = "platform/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true
  }
}
