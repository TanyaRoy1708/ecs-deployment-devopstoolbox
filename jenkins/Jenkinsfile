pipeline {
    agent any

    environment {
        AWS_REGION          = 'us-east-1'
        // Pulled from Jenkins credentials manager
        AWS_ACCOUNT_ID      = credentials('aws-account-id')
        IMAGE_TAG           = "${BUILD_NUMBER}"
        ECS_CLUSTER         = 'ecs-project-cluster'
        ECS_SERVICE         = 'ecs-project-service'
        // SonarCloud Project Key
        SONAR_PROJECT_KEY   = 'TanyaRoy1708_ecs-deployment-devopstoolbox'
    }

    stages {
        stage('Initialize Pipeline') {
            steps {
                script {
                    env.ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                    env.ECR_REPO     = "${env.ECR_REGISTRY}/ecs-project"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Run Unit Tests & Coverage') {
            steps {
                dir('app') {
                    sh '''
                        docker run --rm \
                            -e PYTHONDONTWRITEBYTECODE=1 \
                            -v "$PWD":"$PWD" \
                            -w "$PWD" \
                            python:3.11-slim \
                            sh -c "pip install --quiet -r requirements.txt pytest-cov \
                                   && python -m pytest tests/ -v --tb=short \
                                      --junitxml=test-results.xml \
                                      --cov=. --cov-report=xml:coverage.xml \
                                      2>&1 | tee test-results.txt"
                    '''
                }
            }
            post {
                always {
                    // Publishes results to Jenkins 'Tests' tab
                    junit allowEmptyResults: true, testResults: 'app/test-results.xml'
                    archiveArtifacts artifacts: 'app/test-results.txt,app/coverage.xml', allowEmptyArchive: true
                    
                    // Clean up root-owned cache folders created by Python inside Docker
                    // We use an alpine container to safely delete them without permission errors
                    dir('app') {
                        sh 'docker run --rm -v "$PWD":/app -w /app alpine rm -rf .pytest_cache tests/__pycache__ __pycache__ || true'
                    }
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                dir('app') {
                    // 'SonarCloud' must match the name in Jenkins → Manage Jenkins → System → SonarQube servers
                    // withSonarQubeEnv injects SONAR_HOST_URL and SONAR_TOKEN automatically from Jenkins config
                    withSonarQubeEnv('SonarCloud') {
                        script {
                            // Define the tool. IMPORTANT: 'sonar-scanner' must match the name you gave it in Jenkins Tools!
                            def scannerHome = tool 'sonar-scanner'
                            
                            sh """
                                ${scannerHome}/bin/sonar-scanner \\
                                    -Dsonar.host.url=https://sonarcloud.io \\
                                    -Dsonar.branch.name=${env.BRANCH_NAME ?: 'main'} \\
                                    -Dsonar.buildString=${BUILD_NUMBER}
                            """
                        }
                    }
                }
            }
        }


        stage('Trivy FS Scan') {
            steps {
                dir('app') {
                    sh '''
                        trivy fs --exit-code 0 \
                                 --ignore-unfixed \
                                 --severity HIGH,CRITICAL \
                                 --format table \
                                 --output trivy-fs-report.txt \
                                 .
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'app/trivy-fs-report.txt', allowEmptyArchive: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('app') {
                    sh "docker build -t ${ECR_REPO}:${IMAGE_TAG} ."
                    sh "docker tag ${ECR_REPO}:${IMAGE_TAG} ${ECR_REPO}:latest"
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh '''
                    trivy image --exit-code 0 \
                                --ignore-unfixed \
                                --severity HIGH,CRITICAL \
                                --format table \
                                --output trivy-image-report.txt \
                                ${ECR_REPO}:${IMAGE_TAG}
                '''
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-image-report.txt', allowEmptyArchive: true
                }
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_REGISTRY}
                    docker push ${ECR_REPO}:${IMAGE_TAG}
                    docker push ${ECR_REPO}:latest
                '''
            }
        }

        stage('Deploy to ECS') {
            steps {
                sh '''
                    aws ecs update-service \
                        --cluster ${ECS_CLUSTER} \
                        --service ${ECS_SERVICE} \
                        --force-new-deployment \
                        --region ${AWS_REGION}
                '''
            }
        }

        stage('Verify Deployment') {
            options {
                timeout(time: 5, unit: 'MINUTES')
            }
            steps {
                sh '''
                    aws ecs wait services-stable \
                        --cluster ${ECS_CLUSTER} \
                        --services ${ECS_SERVICE} \
                        --region ${AWS_REGION}
                    echo "Service is stable"
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment successful — Build #${BUILD_NUMBER}"
        }
        failure {
            echo "Pipeline failed — check SonarCloud Quality Gate, Trivy reports, or ECS logs"
        }
        always {
            sh "docker rmi ${ECR_REPO}:${IMAGE_TAG} ${ECR_REPO}:latest || true"
        }
    }
}

