pipeline {
    agent any

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'prod'],
            description: 'Target deployment environment'
        )
    }

    options {
        timeout(time: 30, unit: 'MINUTES')
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
    }

    environment {
        AWS_REGION     = 'us-east-1'
        AWS_ACCOUNT_ID = credentials('aws-account-id')
        PROJECT_NAME   = 'ecs-project'
        ECR_REPO_NAME  = 'ecs-project'
    }

    stages {
        stage('Initialize Pipeline') {
            steps {
                script {
                    env.TARGET_ENV  = params.ENVIRONMENT ?: 'dev'
                    env.ECS_CLUSTER = "${env.PROJECT_NAME}-${env.TARGET_ENV}-cluster"
                    env.ECS_SERVICE = "${env.PROJECT_NAME}-${env.TARGET_ENV}-service"
                    env.TASK_FAMILY = "${env.PROJECT_NAME}-${env.TARGET_ENV}-task"

                    def gitShort     = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG    = "${BUILD_NUMBER}-${gitShort}"
                    env.ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                    env.ECR_REPO     = "${env.ECR_REGISTRY}/${ECR_REPO_NAME}"

                    echo "================================================="
                    echo "Target Environment: ${env.TARGET_ENV}"
                    echo "ECS Cluster:        ${env.ECS_CLUSTER}"
                    echo "ECS Service:        ${env.ECS_SERVICE}"
                    echo "Task Family:        ${env.TASK_FAMILY}"
                    echo "Docker Image:       ${env.ECR_REPO}:${env.IMAGE_TAG}"
                    echo "================================================="
                }
            }
        }

        stage('Run Unit Tests & Coverage') {
            steps {
                dir('app') {
                    sh '''
                        docker run --rm \
                            -e PYTHONDONTWRITEBYTECODE=1 \
                            -v "$PWD":"$PWD" \
                            -w "$PWD" \
                            python:3.11-slim \
                            sh -c "pip install --quiet -r requirements.txt pytest-cov \
                                   && python -m pytest tests/ -v --tb=short \
                                      --junitxml=test-results.xml \
                                      --cov=. --cov-report=xml:coverage.xml \
                                      2>&1 | tee test-results.txt"
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'app/test-results.xml'
                    archiveArtifacts artifacts: 'app/test-results.txt,app/coverage.xml', allowEmptyArchive: true

                    dir('app') {
                        sh 'docker run --rm -v "$PWD":/app -w /app alpine rm -rf .pytest_cache tests/__pycache__ __pycache__ || true'
                    }
                }
            }
        }

        stage('SonarCloud Analysis') {
            steps {
                dir('app') {
                    withSonarQubeEnv('SonarCloud') {
                        script {
                            def scannerHome = tool 'sonar-scanner'
                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                    -Dsonar.branch.name=${env.BRANCH_NAME ?: 'main'} \
                                    -Dsonar.buildString=${BUILD_NUMBER}
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh 'trivy fs --exit-code 0 --ignore-unfixed --severity HIGH,CRITICAL --output trivy-fs-report.txt app'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-fs-report.txt', allowEmptyArchive: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh 'docker build -t "$ECR_REPO:$IMAGE_TAG" app'
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh 'trivy image --exit-code 0 --ignore-unfixed --severity HIGH,CRITICAL --output trivy-image-report.txt "$ECR_REPO:$IMAGE_TAG"'
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-image-report.txt', allowEmptyArchive: true
                }
            }
        }

        stage('Push to ECR') {
            steps {
                sh '''
                    aws ecr get-login-password --region "$AWS_REGION" | \
                        docker login --username AWS --password-stdin "$ECR_REGISTRY"
                    docker push "$ECR_REPO:$IMAGE_TAG"
                '''
            }
        }

        stage('Approve Production Deployment') {
            when { expression { env.TARGET_ENV == 'prod' } }
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input message: "Approve deployment of version ${env.IMAGE_TAG} to PRODUCTION?",
                          ok: "Deploy to Prod"
                }
            }
        }

        stage('Deploy to ECS') {
            steps {
                script {
                    def current = sh(returnStdout: true, script: '''
                        aws ecs describe-services --cluster "$ECS_CLUSTER" --services "$ECS_SERVICE" --region "$AWS_REGION" \
                            --query "services[?status=='ACTIVE'].taskDefinition | [0]" --output text 2>/dev/null || echo None
                    ''').trim()

                    if (!current || current == 'None') {
                        echo "Service ${ECS_SERVICE} not found - image published; run 'terraform apply' in terraform/app to bootstrap."
                        return
                    }
                    env.PREVIOUS_TASK_DEF = current

                    env.NEW_TASK_DEF = sh(returnStdout: true, script: '''
                        set -eu
                        aws ecs describe-task-definition --task-definition "$TASK_FAMILY" --region "$AWS_REGION" --query taskDefinition \
                          | jq --arg IMAGE "$ECR_REPO:$IMAGE_TAG" '
                                .containerDefinitions |= map(if .name == "app" then .image = $IMAGE else . end)
                                | del(.taskDefinitionArn, .revision, .status, .requiresAttributes,
                                      .compatibilities, .registeredAt, .registeredBy, .deregisteredAt)' \
                          > task-definition.json
                        aws ecs register-task-definition --cli-input-json file://task-definition.json --region "$AWS_REGION" \
                            --query 'taskDefinition.taskDefinitionArn' --output text
                    ''').trim()

                    echo "Deploying ${env.NEW_TASK_DEF} (rollback target: ${env.PREVIOUS_TASK_DEF})"
                    sh 'aws ecs update-service --cluster "$ECS_CLUSTER" --service "$ECS_SERVICE" --task-definition "$NEW_TASK_DEF" --region "$AWS_REGION" > /dev/null'
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'task-definition.json', allowEmptyArchive: true
                }
            }
        }

        stage('Verify Deployment') {
            when { expression { env.NEW_TASK_DEF != null } }
            steps {
                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    timeout(time: 10, unit: 'MINUTES') {
                        sh '''
                            set -eu
                            aws ecs wait services-stable --cluster "$ECS_CLUSTER" --services "$ECS_SERVICE" --region "$AWS_REGION"

                            RUNNING=$(aws ecs describe-services --cluster "$ECS_CLUSTER" --services "$ECS_SERVICE" --region "$AWS_REGION" \
                                --query "services[0].deployments[?status=='PRIMARY'].taskDefinition | [0]" --output text)
                            [ "$RUNNING" = "$NEW_TASK_DEF" ] || { echo "Unhealthy: running $RUNNING, expected $NEW_TASK_DEF"; exit 1; }
                            echo "Service is stable on $RUNNING"
                        '''
                    }
                }
            }
        }

        stage('Rollback') {
            when { expression { env.NEW_TASK_DEF != null && currentBuild.currentResult == 'FAILURE' } }
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    sh '''
                        set -eu
                        echo "Rolling back: $NEW_TASK_DEF -> $PREVIOUS_TASK_DEF"
                        aws ecs update-service --cluster "$ECS_CLUSTER" --service "$ECS_SERVICE" --task-definition "$PREVIOUS_TASK_DEF" --region "$AWS_REGION" > /dev/null
                        aws ecs wait services-stable --cluster "$ECS_CLUSTER" --services "$ECS_SERVICE" --region "$AWS_REGION"
                        aws ecs deregister-task-definition --task-definition "$NEW_TASK_DEF" --region "$AWS_REGION" > /dev/null
                        echo "Rollback complete - running $PREVIOUS_TASK_DEF"
                    '''
                }
            }
        }
    }

    post {
        success {
            echo "Deployment successful - Build #${BUILD_NUMBER} | Environment: ${env.TARGET_ENV} | Tag: ${IMAGE_TAG}"
        }
        failure {
            echo "Pipeline failed - Build #${BUILD_NUMBER} | Environment: ${env.TARGET_ENV} | Tag: ${IMAGE_TAG}"
        }
        always {
            sh 'docker rmi "$ECR_REPO:$IMAGE_TAG" || true'
            cleanWs()
        }
    }
}
