pipeline {
    agent any

    options {
        timeout(time: 30, unit: 'MINUTES')           // Kill hung pipelines
        disableConcurrentBuilds()                     // Prevent race conditions on same branch
        buildDiscarder(logRotator(numToKeepStr: '10')) // Keep only last 10 builds
    }

    environment {
        AWS_REGION          = 'us-east-1'
        AWS_ACCOUNT_ID      = credentials('aws-account-id')
        ECS_CLUSTER         = 'ecs-project-cluster'
        ECS_SERVICE         = 'ecs-project-service'
        ECR_REPO_NAME       = 'ecs-project'
        SONAR_PROJECT_KEY   = 'TanyaRoy1708_ecs-deployment-devopstoolbox'
    }

    stages {
        stage('Initialize Pipeline') {
            steps {
                script {
                    // Versioned tag: "<build_number>-<git_short_sha>" for traceability & rollback
                    env.GIT_SHORT   = sh(script: 'git rev-parse --short HEAD', returnStdout: true).trim()
                    env.IMAGE_TAG   = "${BUILD_NUMBER}-${env.GIT_SHORT}"

                    env.ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
                    env.ECR_REPO     = "${env.ECR_REGISTRY}/${ECR_REPO_NAME}"

                    echo "Branch   : ${env.BRANCH_NAME ?: 'unknown'}"
                    echo "Image Tag: ${env.IMAGE_TAG}"
                    echo "ECR Repo : ${env.ECR_REPO}"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // -----------------------------------------------------------------------
        // TEST
        // -----------------------------------------------------------------------
        stage('Run Unit Tests & Coverage') {
            steps {
                dir('app') {
                    sh '''
                        docker run --rm \
                            -e PYTHONDONTWRITEBYTECODE=1 \
                            -v "$PWD":"$PWD" \
                            -w "$PWD" \
                            python:3.11-slim \
                            sh -c "pip install --quiet -r requirements.txt pytest-cov \
                                   && python -m pytest tests/ -v --tb=short \
                                      --junitxml=test-results.xml \
                                      --cov=. --cov-report=xml:coverage.xml \
                                      2>&1 | tee test-results.txt"
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'app/test-results.xml'
                    archiveArtifacts artifacts: 'app/test-results.txt,app/coverage.xml', allowEmptyArchive: true

                    // Safely clean root-owned Docker cache folders
                    dir('app') {
                        sh 'docker run --rm -v "$PWD":/app -w /app alpine rm -rf .pytest_cache tests/__pycache__ __pycache__ || true'
                    }
                }
            }
        }

        // -----------------------------------------------------------------------
        // QUALITY GATE
        // -----------------------------------------------------------------------
        stage('SonarCloud Analysis') {
            steps {
                dir('app') {
                    // sonar-project.properties declares projectKey, org, host, sources, and reports.
                    // withSonarQubeEnv injects SONAR_HOST_URL and SONAR_TOKEN automatically.
                    withSonarQubeEnv('SonarCloud') {
                        script {
                            def scannerHome = tool 'sonar-scanner'
                            sh """
                                ${scannerHome}/bin/sonar-scanner \
                                    -Dsonar.branch.name=${env.BRANCH_NAME ?: 'main'} \
                                    -Dsonar.buildString=${BUILD_NUMBER}
                            """
                        }
                    }
                }
            }
        }

        stage('Quality Gate') {
            steps {
                // Wait for SonarCloud to finish processing and evaluate gate status
                timeout(time: 5, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        // -----------------------------------------------------------------------
        // SECURITY SCANS
        // -----------------------------------------------------------------------
        stage('Trivy FS Scan') {
            steps {
                dir('app') {
                    sh '''
                        trivy fs \
                            --exit-code 0 \
                            --ignore-unfixed \
                            --severity HIGH,CRITICAL \
                            --format table \
                            --output trivy-fs-report.txt \
                            .
                    '''
                }
            }
            post {
                always {
                    archiveArtifacts artifacts: 'app/trivy-fs-report.txt', allowEmptyArchive: true
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('app') {
                    sh "docker build -t ${ECR_REPO}:${IMAGE_TAG} ."
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                // CRITICAL vulnerabilities fail the build
                // HIGH vulnerabilities are archived for review (exit-code 0)
                sh """
                    trivy image \
                        --exit-code 1 \
                        --ignore-unfixed \
                        --severity CRITICAL \
                        --format table \
                        ${ECR_REPO}:${IMAGE_TAG}

                    trivy image \
                        --exit-code 0 \
                        --ignore-unfixed \
                        --severity HIGH \
                        --format table \
                        --output trivy-image-report.txt \
                        ${ECR_REPO}:${IMAGE_TAG}
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'trivy-image-report.txt', allowEmptyArchive: true
                }
            }
        }

        // -----------------------------------------------------------------------
        // PUSH - main branch only
        // -----------------------------------------------------------------------
        stage('Push to ECR') {
            when { branch 'main' }
            steps {
                sh '''
                    aws ecr get-login-password --region ${AWS_REGION} | \
                    docker login --username AWS --password-stdin ${ECR_REGISTRY}
                    docker push ${ECR_REPO}:${IMAGE_TAG}
                '''
            }
        }

        // -----------------------------------------------------------------------
        // DEPLOY - main branch only
        // -----------------------------------------------------------------------
        stage('Deploy to ECS') {
            when { branch 'main' }
            steps {
                sh '''
                    aws ecs update-service \
                        --cluster ${ECS_CLUSTER} \
                        --service ${ECS_SERVICE} \
                        --force-new-deployment \
                        --region ${AWS_REGION}
                '''
            }
        }

        stage('Verify Deployment') {
            when { branch 'main' }
            options {
                timeout(time: 10, unit: 'MINUTES')
            }
            steps {
                sh '''
                    aws ecs wait services-stable \
                        --cluster ${ECS_CLUSTER} \
                        --services ${ECS_SERVICE} \
                        --region ${AWS_REGION}
                    echo "Service is stable - deployment verified"
                '''
            }
        }
    }

    post {
        success {
            echo "Deployment successful - Build #${BUILD_NUMBER} | Tag: ${IMAGE_TAG}"
            // Uncomment below once Slack plugin is configured:
            // slackSend channel: '#deployments', color: 'good',
            //     message: "*${env.JOB_NAME}* #${BUILD_NUMBER} deployed successfully.\nTag: `${IMAGE_TAG}` | Branch: `${env.BRANCH_NAME}`\n${env.BUILD_URL}"
        }
        failure {
            echo "Pipeline failed - Build #${BUILD_NUMBER} | Tag: ${IMAGE_TAG}"
            // slackSend channel: '#deployments', color: 'danger',
            //     message: "*${env.JOB_NAME}* #${BUILD_NUMBER} failed.\nBranch: `${env.BRANCH_NAME}` | Check: ${env.BUILD_URL}"
        }
        always {
            // Remove local Docker image to free disk space on agent
            sh "docker rmi ${ECR_REPO}:${IMAGE_TAG} || true"
            // Wipe the workspace to prevent stale artifact accumulation
            cleanWs()
        }
    }
}
