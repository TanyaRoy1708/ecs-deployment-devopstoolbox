pipeline {
    agent any

    parameters {
        choice(
            name: 'ACTION',
            choices: ['Terraform Plan', 'Terraform Apply', 'Terraform Destroy'],
            description: 'Select the infrastructure management task to perform.'
        )
        booleanParam(
            name: 'CONFIRM_DESTROY',
            defaultValue: false,
            description: 'Check this box to confirm that you intentionally want to DESTROY all project resources. Required only when selecting "Terraform Destroy".'
        )
    }

    environment {
        AWS_REGION         = 'us-east-1'
        AWS_DEFAULT_REGION = 'us-east-1'
        TF_DIR             = 'terraform'
        TF_VARS            = 'environments/dev/terraform.tfvars'
    }

    stages {
        stage('Initialize Pipeline') {
            steps {
                script {
                    env.RUN_ACTION = params.ACTION ?: 'Terraform Plan'
                    echo "🚀 Starting Infrastructure Pipeline"
                    echo "Action: ${env.RUN_ACTION}"
                }
            }
        }

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir(env.TF_DIR) {
                    sh 'terraform init -input=false'
                }
            }
        }

        stage('Terraform Plan') {
            when {
                expression {
                    return env.RUN_ACTION == 'Terraform Plan'
                }
            }
            steps {
                dir(env.TF_DIR) {
                    sh "terraform plan -var-file=${env.TF_VARS} -input=false"
                }
            }
        }

        stage('Terraform Apply') {
            when {
                expression {
                    return env.RUN_ACTION == 'Terraform Apply'
                }
            }
            steps {
                dir(env.TF_DIR) {
                    sh "terraform apply -var-file=${env.TF_VARS} -auto-approve -input=false"
                }
            }
        }

        stage('Terraform Destroy') {
            when {
                expression {
                    return env.RUN_ACTION == 'Terraform Destroy'
                }
            }
            steps {
                script {
                    if (!params.CONFIRM_DESTROY) {
                        error "🚨 ABORTED: 'Terraform Destroy' selected, but 'CONFIRM_DESTROY' checkbox was NOT checked. Infrastructure is safe!"
                    }
                }
                dir(env.TF_DIR) {
                    sh "terraform destroy -var-file=${env.TF_VARS} -auto-approve -input=false"
                }
            }
        }
    }

    post {
        success {
            echo "✅ Infrastructure Pipeline successfully completed Action: ${env.RUN_ACTION} (Build #${BUILD_NUMBER})"
        }
        failure {
            echo "❌ Infrastructure Pipeline failed during Action: ${env.RUN_ACTION}"
        }
    }
}
