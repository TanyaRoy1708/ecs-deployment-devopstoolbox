# Terraform
.terraform/
# NOTE: .terraform.lock.hcl is intentionally NOT ignored.
# Lock files pin provider versions and MUST be committed for reproducible builds.
*.tfstate
*.tfstate.backup
*.tfplan
*.tfplan.json
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# tfvars files may contain secrets (DB passwords, API keys, etc) — never commit them
*.tfvars
*.tfvars.json
# backend.tf is AUTO-GENERATED by scripts/bootstrap-backend.sh
# It contains your real AWS Account ID. NEVER commit it.
# A pre-commit hook in .git/hooks/pre-commit enforces this.
terraform/backend.tf

